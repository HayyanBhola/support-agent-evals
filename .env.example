# URL of the GlowCare agent's chat endpoint (always called with eval_mode=true)
AGENT_URL=http://127.0.0.1:8000/chat
# API key sent to the agent in the X-API-Key header
AGENT_API_KEY=
# Seconds to wait for each agent answer (default 180; `evalkit run --read-timeout` overrides)
AGENT_READ_TIMEOUT_S=180
# Local path to the agent's repo (read-only reference)
AGENT_REPO_PATH=../rag-whatsapp-agent
# Groq key for LLM judges (Llama; must differ from the agent's Gemini family)
GROQ_API_KEY=
# OpenAI key for synthetic test-case generation (`evalkit generate`, default gpt-5-mini)
OPENAI_API_KEY=
# Anthropic key for optional secondary judges
ANTHROPIC_API_KEY=
# Enable LangSmith tracing (true/false)
LANGSMITH_TRACING=false
# LangSmith API endpoint
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LangSmith API key
LANGSMITH_API_KEY=
# LangSmith project name for traces
LANGSMITH_PROJECT=glowcare-support-agent
