{
  "$defs": {
    "AnswerType": {
      "enum": [
        "llm",
        "quoted_source",
        "not_found"
      ],
      "title": "AnswerType",
      "type": "string"
    },
    "ResponseSource": {
      "enum": [
        "database",
        "knowledge_base",
        "fixed_reply"
      ],
      "title": "ResponseSource",
      "type": "string"
    },
    "RetrievedChunk": {
      "additionalProperties": true,
      "description": "A knowledge-base chunk the agent retrieved.\n\n``score`` is a Chroma distance: LOWER score = MORE relevant.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "id",
        "text",
        "score"
      ],
      "title": "RetrievedChunk",
      "type": "object"
    },
    "Route": {
      "enum": [
        "escalate",
        "guardrail",
        "medical",
        "greeting",
        "clarify",
        "database",
        "knowledge"
      ],
      "title": "Route",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "The JSON body returned by the agent's ``POST /chat``.\n\nOnly ``ok`` and ``reply`` are required; every other field is Optional because at least\none route (or the error branch) sends it as null or omits it.",
  "properties": {
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "reply": {
      "title": "Reply",
      "type": "string"
    },
    "conversation_id": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "new_chat": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Chat"
    },
    "route": {
      "anyOf": [
        {
          "$ref": "#/$defs/Route"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "answer_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "escalated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Escalated"
    },
    "escalation": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Escalation"
    },
    "memory": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "eval_mode": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eval Mode"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "latency_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "intents": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intents"
    },
    "details": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Details"
    },
    "retrieved_chunks": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RetrievedChunk"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieved Chunks"
    },
    "prompt_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Tokens"
    },
    "completion_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Tokens"
    }
  },
  "required": [
    "ok",
    "reply"
  ],
  "title": "AgentResponse",
  "type": "object"
}
