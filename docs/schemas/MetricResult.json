{
  "additionalProperties": false,
  "description": "One metric computed for one case. At least one of value / passed is set.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "case_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "metric": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Metric",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Passed"
    },
    "details": {
      "additionalProperties": true,
      "default": {},
      "title": "Details",
      "type": "object"
    }
  },
  "required": [
    "case_id",
    "metric"
  ],
  "title": "MetricResult",
  "type": "object"
}
